{
    "name": "@beautiful/design",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "A collection of beautiful Obsidian plugins.",
    "author": "Mayaz Rakib",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mayazrakib/beautiful-obsidian.git"
    },
    "homepage": "https://github.com/mayazrakib/beautiful-obsidian#readme",
    "bugs": {
        "url": "https://github.com/mayazrakib/beautiful-obsidian/issues"
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "scripts": {
        "dev": "node ../tools/scripts/build_design.mjs --watch",
        "build": "tsc -p tsconfig.build.json && node ../tools/scripts/build_design.mjs",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "peerDependencies": {
        "obsidian": ">=1.12.0 <2"
    },
    "devDependencies": {
        "obsidian": "1.14.4"
    }
}
