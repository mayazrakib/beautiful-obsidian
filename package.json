{
    "name": "beautiful-obsidian",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "A collection of beautiful Obsidian plugins.",
    "author": "Mayaz Rakib",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mayazrakib/beautiful-obsidian.git"
    },
    "homepage": "https://github.com/mayazrakib/beautiful-obsidian#readme",
    "bugs": {
        "url": "https://github.com/mayazrakib/beautiful-obsidian/issues"
    },
    "engines": {
        "node": ">=24 <25",
        "npm": ">=11"
    },
    "workspaces": [
        "design",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run build --workspace=@beautiful/design && node tools/scripts/dev.mjs",
        "build": "npm run build --workspace=@beautiful/design && npm run build --workspace=@beautiful/inbox && node tools/scripts/verify_build.mjs",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "lint": "eslint .",
        "test": "vitest run",
        "check": "npm run typecheck && npm run lint && npm test && npm run build",
        "dev:design": "npm run dev --workspace=@beautiful/design",
        "dev:inbox": "npm run build --workspace=@beautiful/design && npm run dev --workspace=@beautiful/inbox",
        "pretypecheck": "npm run build --workspace=@beautiful/design",
        "pretest": "npm run build --workspace=@beautiful/design"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@types/node": "^24.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "globals": "^17.6.0",
        "jsdom": "^30.1.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    },
    "packageManager": "npm@11.19.1"
}
