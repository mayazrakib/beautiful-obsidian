{
    "name": "beautiful_obsidian",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "A collection of beautiful Obsidian plugins.",
    "author": "Mayaz Rakib",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mayazrakib/beautiful_obsidian.git"
    },
    "homepage": "https://github.com/mayazrakib/beautiful_obsidian#readme",
    "bugs": {
        "url": "https://github.com/mayazrakib/beautiful_obsidian/issues"
    },
    "engines": {
        "node": ">=24 <25",
        "npm": ">=11"
    },
    "workspaces": [
        "design",
        "packages/*"
    ],
    "scripts": {
        "dev": "npm run dev --workspace=@beautiful/design",
        "build": "npm run build --workspaces --if-present && node scripts/verify_build.mjs",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "lint": "eslint .",
        "test": "vitest run",
        "check": "npm run typecheck && npm run lint && npm test && npm run build"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@types/node": "^24.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "globals": "^17.6.0",
        "jsdom": "^29.1.1",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^4.1.12"
    },
    "packageManager": "npm@11.19.1"
}
